  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-healthkit/core": "^16.2.0",
    "expo": "~58.0.24",
    "expo-apple-authentication": "~58.0.3",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.7",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "^58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "^58.0.4",
    "expo-linking": "~58.0.17",
    "expo-live-activity": "^0.4.2",
    "expo-notifications": "~58.1.9",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "^0.21.4",
