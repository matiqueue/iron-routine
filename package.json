{
  "name": "iron-routine",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~58.0.24",
    "expo-haptics": "^58.0.8",
    "expo-keep-awake": "^58.0.4",
    "expo-live-activity": "^0.4.2",
    "expo-notifications": "~58.1.9",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "prepare": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/data/myPlan.ts')) fs.copyFileSync('src/data/myPlan.template.ts','src/data/myPlan.ts')\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deploy": "bash scripts/deploy.sh",
    "ios:release": "expo run:ios --configuration Release",
    "prebuild:ios": "expo prebuild --platform ios",
    "web": "expo start --web"
  },
  "private": true
}
