  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/data/myPlan.ts')) fs.copyFileSync('src/data/myPlan.template.ts','src/data/myPlan.ts'); if(!fs.existsSync('src/data/localSeed.ts')) fs.copyFileSync('src/data/localSeed.template.ts','src/data/localSeed.ts')\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deploy": "bash scripts/deploy.sh",
    "ios:release": "expo run:ios --configuration Release",
    "prebuild:ios": "expo prebuild --platform ios",
    "web": "expo start --web",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major"
  },
  "private": true
}
